{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "walletie",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atdev-cloud-db",
      "database_id": "2bd7bc05-3f00-4faf-9dff-054b0c50b98a",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  }
}
